# Copy to .env (project root) and adjust. Never commit real credentials.
# ---------------------------------------------------------------- server
NODE_ENV=development
PORT=4000
# Public URL of the frontend (used for invitation links, CORS/origin checks and emails)
APP_URL=http://localhost:5173
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET=change-me-to-a-long-random-string
# Public URL of this backend (used for locally stored media URLs)
PUBLIC_API_URL=http://localhost:4000
#
# --- Two-computer multiplayer on the same Wi-Fi (see "REAL-TIME MULTIPLAYER" in README.md) ---
# Only the HOST computer runs the backend. Find its LAN IP with `ipconfig` (IPv4 Address, e.g.
# 192.168.1.42), then set BOTH URLs below to that IP on the Vite port 5173 so invitation links,
# origin checks, Socket.IO and media all work from the other computer. Both players then open
# http://<HOST-LAN-IP>:5173. Everything (API, /socket.io, /media) is proxied through port 5173,
# so only that one port needs to be reachable. Example:
#   APP_URL=http://192.168.1.42:5173
#   PUBLIC_API_URL=http://192.168.1.42:5173
# Leave the localhost values above for normal single-computer development.

# ---------------------------------------------------------------- MySQL 8.0.16+
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=rush_root_dev
DB_NAME=rush
# Database used by the automated tests (created and reset by the test runner; never "rush")
DB_TEST_NAME=rush_test

# ---------------------------------------------------------------- translation
# google | mock | none   (mock = clearly marked fake translations for local development)
TRANSLATION_PROVIDER=google
# Google Cloud Translation API (Basic, v2) key
GOOGLE_TRANSLATE_API_KEY=
# OpenAI API key for contextual explanations (optional; explanation is skipped when empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Timeout for each external API call in milliseconds
EXTERNAL_API_TIMEOUT_MS=8000

# ---------------------------------------------------------------- email (Nodemailer SMTP)
# When SMTP_HOST is empty, emails are only printed to the backend console (no real email is sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="RUSH! <no-reply@rush.local>"

# ---------------------------------------------------------------- media storage
# local = files saved in backend/uploads and served at /media (development only)
# s3    = any S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, ...)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket, e.g. https://my-bucket.s3.eu-west-1.amazonaws.com
S3_PUBLIC_BASE_URL=

# =========================================================
# EXPLICACIÓN DEL ARCHIVO
# =========================================================
#
# Propósito: Plantilla con todas las variables de entorno que acepta el backend, con valores de
# ejemplo sin secretos reales.
#
# Responsabilidades principales:
# - Documentar variables de servidor, MySQL, traducción, correo y almacenamiento.
#
# Elementos importantes:
# - PORT, APP_URL, SESSION_SECRET, PUBLIC_API_URL, DB_*, TRANSLATION_PROVIDER,
#   GOOGLE_TRANSLATE_API_KEY, OPENAI_*, SMTP_*, STORAGE_DRIVER, S3_*
#
# Dependencias:
# - backend/src/config/env.ts
#
# Flujo de datos:
# Se copia como .env y se completa localmente.
#
# Aspectos técnicos importantes:
# - El archivo .env real no se comparte ni se versiona.
#
# Lugar en la arquitectura:
# Configuración. Explica cómo configurar el sistema.
